```gitattributes
# Normalize line endings
* text=auto

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Java source
*.java text

# Configuration files
*.properties text
*.yml text
*.yaml text
*.xml text

# Markdown
*.md text

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
```
